{
  "name": "memoria",
  "version": "0.8.0",
  "description": "Second brain offline untuk semua AI coding tools - capture session dari Claude, Codex, Gemini, Copilot, Antigravity, opencode, VS Code, Cursor & Windsurf",
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "desktopName": "Memoria",
  "homepage": "https://github.com/xinzzu/Memoria",
  "author": {
    "name": "xinzzu",
    "email": "xinzzui@gmail.com",
    "url": "https://github.com/xinzzu"
  },
  "scripts": {
    "build": "tsc -p tsconfig.engine.json",
    "dev": "tsc -p tsconfig.engine.json --watch",
    "scan": "node dist/engine/index.js scan",
    "recall": "node dist/engine/index.js recall",
    "status": "node dist/engine/index.js status",
    "mcp": "node dist/engine/index.js mcp",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "check:ui": "node scripts/audit-ui.js",
    "test": "npm run build && node --test tests/core.test.mjs tests/migration.test.mjs tests/webhook.test.mjs tests/openai-embed.test.mjs tests/sync-m1.test.mjs tests/sync-crypto.test.mjs tests/sync-m2.test.mjs tests/sync-m3.test.mjs tests/f4.test.mjs tests/v6.test.mjs tests/consolidate.test.mjs tests/smart-remember.test.mjs tests/import-md.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.memoria.app",
    "productName": "Memoria",
    "files": [
      "dist/**/*",
      "web/**/*",
      "logo.png",
      "package.json"
    ],
    "asarUnpack": [
      "dist/engine/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Second brain offline untuk AI coding tools",
      "maintainer": "Memoria <memoria@localhost>",
      "desktop": {
        "entry": {
          "Name": "Memoria"
        }
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
