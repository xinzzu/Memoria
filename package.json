{
  "name": "@xinzzu/memoria",
  "version": "0.17.1",
  "description": "Local-first memory for AI coding tools: capture Claude Code, Codex, Gemini CLI, Copilot, Cursor and more, recall anywhere over MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinzzu/Memoria.git"
  },
  "homepage": "https://memoria.xinzzu.web.id",
  "bugs": {
    "url": "https://github.com/xinzzu/Memoria/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "memory",
    "ai-memory",
    "agent-memory",
    "second-brain",
    "claude-code",
    "claude",
    "codex",
    "gemini-cli",
    "copilot",
    "cursor",
    "windsurf",
    "opencode",
    "local-first",
    "offline",
    "sqlite",
    "knowledge-base",
    "developer-tools"
  ],
  "main": "dist/electron/main.js",
  "bin": {
    "memoria": "dist/engine/index.js"
  },
  "files": [
    "dist/engine/",
    "web/",
    "logo.png",
    "README.md",
    "LICENSE",
    "PRIVACY.md"
  ],
  "type": "commonjs",
  "desktopName": "Memoria",
  "author": {
    "name": "xinzzu",
    "email": "xinzzui@gmail.com",
    "url": "https://github.com/xinzzu"
  },
  "scripts": {
    "build": "tsc -p tsconfig.engine.json",
    "dev": "tsc -p tsconfig.engine.json --watch",
    "scan": "node dist/engine/index.js scan",
    "recall": "node dist/engine/index.js recall",
    "status": "node dist/engine/index.js status",
    "mcp": "node dist/engine/index.js mcp",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "check:ui": "node scripts/audit-ui.js",
    "test": "npm run build && node --test tests/core.test.mjs tests/ollama-serve.test.mjs tests/team-brain.test.mjs tests/journal.test.mjs tests/sync-devices-api.test.mjs tests/noise-lang.test.mjs tests/scope.test.mjs tests/migration.test.mjs tests/legacy-roles.test.mjs tests/inspector.test.mjs tests/session-events.test.mjs tests/events.test.mjs tests/backfill.test.mjs tests/lifecycle.test.mjs tests/retention.test.mjs tests/toolset.test.mjs tests/health.test.mjs tests/doctor.test.mjs tests/evidence.test.mjs tests/webhook.test.mjs tests/openai-embed.test.mjs tests/sync-m1.test.mjs tests/sync-crypto.test.mjs tests/sync-m2.test.mjs tests/sync-m3.test.mjs tests/sync-m5.test.mjs tests/f4.test.mjs tests/v6.test.mjs tests/consolidate.test.mjs tests/smart-remember.test.mjs tests/import-md.test.mjs tests/heuristic-mode.test.mjs tests/tier0.test.mjs tests/tier0-polish.test.mjs tests/context.test.mjs tests/privacy.test.mjs tests/file-decisions.test.mjs tests/security.test.mjs tests/ingest.test.mjs tests/onboarding.test.mjs tests/hooks.test.mjs tests/import-chats-obsidian.test.mjs tests/version.test.mjs tests/tasks-list.test.mjs",
    "eval:heuristic": "npm run build && node scripts/eval-heuristic.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.memoria.app",
    "productName": "Memoria",
    "extraMetadata": {
      "name": "memoria"
    },
    "files": [
      "dist/**/*",
      "web/**/*",
      "logo.png",
      "package.json"
    ],
    "asarUnpack": [
      "dist/engine/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Offline second brain for AI coding tools",
      "maintainer": "Memoria <memoria@localhost>",
      "desktop": {
        "entry": {
          "Name": "Memoria"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "mcpName": "io.github.xinzzu/memoria"
}
